# Optional Open-Meteo commercial / self-hosted endpoint.
# Non-commercial default is https://api.open-meteo.com (rate-limited).
# Commercial use requires a subscription: https://open-meteo.com/en/pricing
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
# OPEN_METEO_API_KEY=

# Optional METAR endpoint override (aviationweather.gov Data API by default)
# METAR_BASE_URL=https://aviationweather.gov/api/data/metar

# Optional Synoptic Data token (free tier: https://customer.synopticdata.com/).
# Enables the exact NOAA-timeseries resolution feed (5-minute ASOS obs) instead of
# the METAR-body lower bound. Leave unset to skip.
# SYNOPTIC_TOKEN=

# Optional Weather Underground / weather.com API key. The public web key is
# used when unset. App still runs METAR-only if weather.com rejects the key.
# WU_API_KEY=

# Optional Météo-France API key (portail-api.meteofrance.fr, subscribed to
# DonneesPubliquesObservation v2). Adds the 6-minute Le Bourget obs to the LFPB
# PWS panel; that card shows an error when unset.
# METEO_FRANCE_API_KEY=

# Optional data.gov.sg API key. The WSSS PWS card reads the 1-minute Changi (S24)
# temperature; without a key the endpoint rate-limits quickly (HTTP 429).
# SINGAPORE_API_KEY=
